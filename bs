local SizeThreshold = 15 
local Whitelist = {"TreeOrb", "Spirit", "Arrow", "Detection"}
local function isWhitelisted(object)
    local function checkName(obj)
        if not obj then return false end
        local name = obj.Name:lower()
        for _, word in pairs(Whitelist) do
            if name:find(word:lower()) then return true end
        end
        return false
    end
    if checkName(object) then return true end
    if object.Parent and checkName(object.Parent) then return true end
    if object.Parent and object.Parent.Parent and checkName(object.Parent.Parent) then return true end
    return false
end


