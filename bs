local function PushHistory(actionType, oldPos, newPos, idx)
    table.insert(HubState.UndoStack, { 
        Type = actionType, Team = ShotData.Settings.TargetEditTeam, Action = ShotData.Settings.TargetEditAction, 
        Index = idx or ShotData.Settings.TargetEditIndex, OldPos = oldPos, NewPos = newPos
    })
    HubState.RedoStack = {} 
end


local function applyOffset(axis, amount)
    local tm, ac = ShotData.Settings.TargetEditTeam, ShotData.Settings.TargetEditAction
    local list = ShotData.Targets[tm][ac]
    local idx = math.clamp(ShotData.Settings.TargetEditIndex, 1, math.max(1, #list))
    if not list[idx] then return end
    
    local oldPos = DeepCopy(list[idx])
    local newPos = DeepCopy(oldPos)
    
    if axis == "X" then newPos.Off = {X=oldPos.Off.X + amount, Y=oldPos.Off.Y, Z=oldPos.Off.Z}
    elseif axis == "Y" then newPos.Off = {X=oldPos.Off.X, Y=oldPos.Off.Y + amount, Z=oldPos.Off.Z}
    elseif axis == "Z" then newPos.Off = {X=oldPos.Off.X, Y=oldPos.Off.Y, Z=oldPos.Off.Z + amount}
    end
    
    PushHistory("Adjust", oldPos, newPos, idx)
    list[idx] = newPos
    updateShotVisuals(); SaveShotData()
end


