-- // AIMBOT ENGINE //
local S_WasPayloadActive, S_CachedCharge, S_CachedShotType = false, 0, "Kick"
local S_IsAimbotting, S_ShotStartTime = false, 0
local S_StartPos, S_CurrentTarget = nil, nil
local S_ActiveCurve, S_ActiveSpeed = 0, 1
local S_FollowThroughDir = Vector3.zero


table.insert(ShotConnections, s_RunService.Heartbeat:Connect(function(dt)
    for _, marker in ipairs(ActiveShotMarkers) do
        if marker.Part and marker.TargetPart and marker.TargetPart.Parent then marker.Part.Position = marker.TargetPart.CFrame:PointToWorldSpace(Vector3.new(marker.Data.Off.X, marker.Data.Off.Y, marker.Data.Off.Z)) end
    end


    local char = l_LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local ball = getOwnedFootballShot()
    
    if ball then
        local payloadActive = false
        if r_PrepareShot then
            pcall(function()
                local payload = r_PrepareShot.GetPayload()
                if payload and payload.Active then
                    payloadActive = true; S_CachedCharge = (payload.Charge or 0) * 100
                    S_CachedShotType = (payload.Shot == "Pass") and "Pass" or "Kick"
                    S_WasPayloadActive = true
                end
            end)
        else
            S_CachedShotType = (ball:GetAttribute("Action") == "Pass" or ball:GetAttribute("KickType") == "Pass") and "Pass" or "Kick"
            S_CachedCharge = 100
        end


        if S_WasPayloadActive and not payloadActive then
            S_WasPayloadActive = false
            local Prefix = (S_CachedShotType == "Kick") and "Kick" or "Pass"
            
            if ShotData.Settings[Prefix .. "Enabled"] then
                local targetPos, myTeam = nil, l_LocalPlayer:GetAttribute("IsHomeOrAway") or (char and char:GetAttribute("IsHomeOrAway"))
                local enemyTeam = (myTeam == "Home") and "Away" or "Home"


                if ShotData.Settings[Prefix .. "Focus"] == "Goal" then
                    local targetSide = getEnemyGoalShot(ShotData.Settings[Prefix .. "TargetGoal"])
                    if targetSide and ShotData.Targets[targetSide] then
                        local resolvedList = {}
                        for _, tData in ipairs(ShotData.Targets[targetSide][S_CachedShotType]) do table.insert(resolvedList, ResolveTargetShot(tData)) end
                        targetPos = selectGoalTargetShot(resolvedList, ShotData.Settings[Prefix .. "GoalMode"], hrp.Position, l_Camera.CFrame, ShotData.Settings[Prefix .. "FOV"], getGKPositionShot(enemyTeam), ShotData.Settings[Prefix .. "FarThreshold"], ShotData.Settings[Prefix .. "SmartNearMode"])
                    end
                else
                    targetPos = getBestTeammateShot(ShotData.Settings[Prefix .. "MaxRange"], ShotData.Settings[Prefix .. "TeammateMode"], ShotData.Settings[Prefix .. "FOV"], myTeam)
                end


                if targetPos then
                    local distance = (ball.Position - targetPos).Magnitude
                    if S_CachedCharge >= ShotData.Settings[Prefix .. "ReqPower"] and distance <= ShotData.Settings[Prefix .. "MaxRange"] then
                        S_IsAimbotting = true; S_ShotStartTime = os.clock(); S_StartPos = ball.Position; S_CurrentTarget = targetPos
                        S_FollowThroughDir = (Vector3.new(S_CurrentTarget.X, S_CurrentTarget.Y, S_CurrentTarget.Z) - S_StartPos).Unit
                        
                        if ShotData.Settings[Prefix .. "SmartCurve"] then S_ActiveSpeed = math.clamp(distance / 130, 0.4, 2.5); S_ActiveCurve = (S_CachedShotType == "Kick") and math.clamp(distance * 0.15, 10, 80) or 0
                        else S_ActiveSpeed = ShotData.Settings[Prefix .. "ManualSpeed"]; S_ActiveCurve = ShotData.Settings[Prefix .. "ManualCurve"] end
                    end
                end
            end
        end


        if S_IsAimbotting then
            local elapsed = os.clock() - S_ShotStartTime
            local t = math.min(elapsed / S_ActiveSpeed, 1)
            
            if t < 1 then
                local p0, p2 = S_StartPos, S_CurrentTarget
                local p1 = p0:Lerp(p2, 0.5) + Vector3.new(0, S_ActiveCurve, 0)
                local u = 1 - t
                local curvePos = (u^2 * p0) + (2 * u * t * p1) + (t^2 * p2)
                
                local instVel = (curvePos - ball.Position) / dt
                ball.AssemblyLinearVelocity = instVel
                ball:PivotTo(CFrame.new(curvePos) * ball.CFrame.Rotation)
            else
                S_IsAimbotting = false; ball.AssemblyLinearVelocity = S_FollowThroughDir * 50
            end
        end
    else
        S_IsAimbotting = false; S_WasPayloadActive = false
    end
end))


