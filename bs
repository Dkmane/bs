local originalSizes = {}
local function resizeHitbox(teamName)
    local multi = tonumber(SaveData.Settings.GoalHitboxMulti) or 2
    local trans = tonumber(SaveData.Settings.GoalHitboxTrans) or 0.5
    local path = workspace:FindFirstChild("Stadium")
    if path and path:FindFirstChild("Teams") and path.Teams:FindFirstChild(teamName) then
        local hitbox = path.Teams[teamName]:FindFirstChild("Goal") and path.Teams[teamName].Goal:FindFirstChild("Hitbox")
        if hitbox and hitbox:IsA("BasePart") then
            if not originalSizes[teamName] then originalSizes[teamName] = hitbox.Size end
            hitbox.Size = originalSizes[teamName] * multi
            hitbox.Transparency = trans 
            hitbox.CanCollide = false
        end
    end
end


local function applyAutoExpandOpponentHitbox()
    if not SaveData.Settings.AutoExpandOpponentHitbox then return end
    local mySide = getMySide()
    if not mySide then return end
    local opponentSide = (mySide == "Home") and "Away" or "Home"
    resizeHitbox(opponentSide)
end


