-- PERF: Same cache as findCorrectPart — shot marker loop was calling this
-- every Heartbeat frame per marker, causing a full workspace scan 60fps.
local _shotPartCache = {}
local function findCorrectPartShot(partName, worldPos)
    local key = partName .. "_" .. math.floor(worldPos.X) .. "_" .. math.floor(worldPos.Y) .. "_" .. math.floor(worldPos.Z)
    local cached = _shotPartCache[key]
    if cached and cached.Parent then return cached end
    _shotPartCache[key] = nil
    local bestPart, shortestDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == partName then
            local dist = (obj.Position - worldPos).Magnitude
            if dist < shortestDist then shortestDist = dist; bestPart = obj end
        end
    end
    local result = (shortestDist < 100) and bestPart or nil
    if result then _shotPartCache[key] = result end
    return result
end


local function ResolveTargetShot(data)
    local targetPart = findCorrectPartShot(data.PartName, Vector3.new(data.WorldPos.X, data.WorldPos.Y, data.WorldPos.Z))
    if targetPart then return targetPart.CFrame:PointToWorldSpace(Vector3.new(data.Off.X, data.Off.Y, data.Off.Z)) end
    return Vector3.new(data.WorldPos.X, data.WorldPos.Y, data.WorldPos.Z)
end


