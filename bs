-- ==========================================
-- SUPER ENGINE (RunService Loop)
-- ==========================================
local CachedCharge = 0
local ShotStartTime = 0
local StartPos = nil
local IsAimbotting = false
local wasKeepaway = false


getgenv().WasBallReleased = false
getgenv().PreChargedShot = false


RegisterConnection(s_RunService.Heartbeat:Connect(function(dt)
    local char = l_LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart


    if SaveData.Settings.DKay_BicycleActive and Knit then
        pcall(function()
           local SkillsController = Knit.GetController("SkillsController")
            if SkillsController then
                local currentStatuses = SkillsController.States.Statuses:get() or {}
                if currentStatuses.BicycleKick ~= "Active" then
                    currentStatuses.BicycleKick = "Active"
                    SkillsController.States.Statuses:set(currentStatuses)
                end
            end
        end)
    end


    local runJedi = false
    if SaveData.Settings.DKay_JediGrabActive then
        if SaveData.Settings.DKay_JediMode == "Hold" then
            local jediKeyStr = SaveData.Keybinds["DKay_JediGrabActive"]
            local jediKeyPressed = false
            if jediKeyStr then pcall(function() jediKeyPressed = s_UserInputService:IsKeyDown(Enum.KeyCode[jediKeyStr]) end) end
            runJedi = getgenv().JediBubbleHeld or jediKeyPressed
        else
            runJedi = true
        end
    end
    
    local anyBalls = getAnyFootballs()
    if runJedi and root and #anyBalls > 0 then
        for _, anyBall in ipairs(anyBalls) do
            local pullDirection = (root.Position - anyBall.Position).Unit
            anyBall.AssemblyLinearVelocity = pullDirection * 120
        end
    end
    
    if SaveData.Settings.DKay_JediAnim then
        local animator = char:FindFirstChild("Humanoid") and char.Humanoid:FindFirstChild("Animator")
        if animator and not getgenv().JediAnimTrack then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://507768375"
            getgenv().JediAnimTrack = animator:LoadAnimation(anim)
            getgenv().JediAnimTrack.Looped = true
            getgenv().JediAnimTrack.Priority = Enum.AnimationPriority.Action
        end
        if runJedi and #anyBalls > 0 then
            if getgenv().JediAnimTrack and not getgenv().JediAnimTrack.IsPlaying then getgenv().JediAnimTrack:Play() end
        else
            if getgenv().JediAnimTrack and getgenv().JediAnimTrack.IsPlaying then getgenv().JediAnimTrack:Stop() end
        end
    else
        if getgenv().JediAnimTrack and getgenv().JediAnimTrack.IsPlaying then getgenv().JediAnimTrack:Stop() end
    end


    if SaveData.Settings.DKay_MagnetSelf and root then
        for _, magBall in ipairs(getClosestFootballs()) do
            magBall.CFrame = root.CFrame * CFrame.new(0, -1.5, -1.5)
            magBall.AssemblyLinearVelocity = Vector3.zero
            magBall.AssemblyAngularVelocity = Vector3.zero
        end
    end


    local ownedBalls = getOwnedFootballs()
    local ball = ownedBalls[1]


    if not ball then
        if r_PrepareShot then
            pcall(function()
                local payload = r_PrepareShot.GetPayload()
                if payload and payload.Active then getgenv().PreChargedShot = true end
            end)
        end
    end


    if ball then
        local isReleased = ball:GetAttribute("State") == "Released"


        if isReleased and not getgenv().WasBallReleased then
            if SaveData.Settings.DKay_BicycleActive and not getgenv().PreChargedShot then
                task.delay(2.5, function()
                    pcall(function()
                        local MovementController = Knit.GetController("MovementController")
                        if MovementController then
                            MovementController:SetSprintingControlState(false)
                            task.delay(0.1, function() MovementController:SetSprintingControlState(true) end)
                        end
                    end)
                end)
            end
            getgenv().PreChargedShot = false
        end
        getgenv().WasBallReleased = isReleased


        if not isReleased then
            IsAimbotting = false; ShotStartTime = 0; StartPos = nil; wasKeepaway = false
            
            if r_PrepareShot then
                pcall(function()
                    local payload = r_PrepareShot.GetPayload()
                    if payload and payload.Active then CachedCharge = (payload.Charge or 0) * 100 else CachedCharge = 0 end
                end)
            else CachedCharge = 100 end


            if SaveData.Settings.DKay_KeepawayActive and SaveData.Settings.DKay_KeepawayAutoKick then triggerQuickKick() end
            if SaveData.Settings.DKay_OrbitActive and SaveData.Settings.DKay_OrbitAutoKick then triggerQuickKick() end
            
        else
            local function checkKey(bindName)
                local k = SaveData.Keybinds[bindName]
                if k then
                    local success, isDown = pcall(function() return s_UserInputService:IsKeyDown(Enum.KeyCode[k]) end)
                    return success and isDown
                end
                return false
            end


            local fwd = HeldButtons.Forward or checkKey("Ctrl_Fwd")
            local bck = HeldButtons.Backward or checkKey("Ctrl_Bck")
            local rgt = HeldButtons.Right or checkKey("Ctrl_Rgt")
            local lft = HeldButtons.Left or checkKey("Ctrl_Lft")
            local ctrlActive = fwd or bck or lft or rgt
            
            if ctrlActive then
                local cam = workspace.CurrentCamera
                local look = cam.CFrame.LookVector
                local right = cam.CFrame.RightVector
                local flatLook = Vector3.new(look.X, 0, look.Z).Unit
                local flatRight = Vector3.new(right.X, 0, right.Z).Unit
                
                for _, oball in ipairs(ownedBalls) do
                    local vel = oball.AssemblyLinearVelocity
                    local angVel = oball.AssemblyAngularVelocity
                    
                    if SaveData.Settings.DKay_CtrlMode == "Regular" then
                        if fwd then vel += flatLook * SaveData.Settings.DKay_CtrlStraightInc end
                        if bck then vel += -flatLook * SaveData.Settings.DKay_CtrlStraightInc end
                        if rgt then vel += flatRight * SaveData.Settings.DKay_CtrlStraightInc end
                        if lft then vel += -flatRight * SaveData.Settings.DKay_CtrlStraightInc end
                        oball.AssemblyLinearVelocity = vel
                    elseif SaveData.Settings.DKay_CtrlMode == "Curve" then
                        if fwd then vel += Vector3.new(0, -SaveData.Settings.DKay_CtrlCurveInc * 0.5, 0); angVel = flatRight * 30 end
                        if bck then vel += Vector3.new(0, SaveData.Settings.DKay_CtrlCurveInc * 0.5, 0); angVel = -flatRight * 30 end
                        if rgt then vel += flatRight * SaveData.Settings.DKay_CtrlCurveInc; angVel = Vector3.new(0, -30, 0) end
                        if lft then vel += -flatRight * SaveData.Settings.DKay_CtrlCurveInc; angVel = Vector3.new(0, 30, 0) end
                        oball.AssemblyLinearVelocity = vel; oball.AssemblyAngularVelocity = angVel
                    end
                end
                
            elseif SaveData.Settings.DKay_KeepawayActive then
                wasKeepaway = true
                for i, oball in ipairs(ownedBalls) do
                    local angleOffset = (math.pi * 2 / #ownedBalls) * i
                    local spread = #ownedBalls > 1 and Vector3.new(math.cos(angleOffset)*2, 0, math.sin(angleOffset)*2) or Vector3.zero
                    oball:PivotTo(root.CFrame * CFrame.new(spread.X, 15, spread.Z))
                    oball.AssemblyLinearVelocity = Vector3.zero
                end


            elseif SaveData.Settings.DKay_BlatantAim then
                if wasKeepaway then wasKeepaway = false end 
                local targetTeam = SaveData.Settings.DKay_TargetTeam
                if targetTeam == "Auto" then
                    local myTeam = l_LocalPlayer:GetAttribute("IsHomeOrAway") or (l_LocalPlayer.Team and l_LocalPlayer.Team.Name)
                    targetTeam = (myTeam == "Home") and "Home" or "Away"
                end
                
                local targetPos = GoalTargets[targetTeam]
                if not IsAimbotting and ShotStartTime == 0 then
                    if CachedCharge >= SaveData.Settings.DKay_ReqPower then
                        IsAimbotting = true; ShotStartTime = os.clock(); StartPos = ball.Position
                    else ShotStartTime = -1 end
                end
                
                if IsAimbotting then
                    local elapsed = os.clock() - ShotStartTime
                    local t = math.min(elapsed / SaveData.Settings.DKay_ShotSpeed, 1)
                    if t < 1 then
                        local newPos = Vector3.zero
                        local mode = SaveData.Settings.DKay_PathMode
                        if mode == "Straight" then newPos = StartPos:Lerp(targetPos, t)
                        elseif mode == "Curved" then
                            local p1 = StartPos:Lerp(targetPos, 0.5) + Vector3.new(0, 80, 0)
                            local u = 1 - t
                            newPos = (u^2 * StartPos) + (2 * u * t * p1) + (t^2 * targetPos)
                        elseif mode == "ZigZag" then
                            local basePos = StartPos:Lerp(targetPos, t)
                            local forwardDir = (targetPos - StartPos).Unit
                            local rightDir = forwardDir:Cross(Vector3.yAxis).Unit
                            local offset = rightDir * math.sin(t * math.pi * 6) * 15
                            newPos = basePos + offset
                        end
                        ball:PivotTo(CFrame.new(newPos) * ball.CFrame.Rotation)
                        ball.AssemblyLinearVelocity = Vector3.zero
                    else
                        IsAimbotting = false
                        ball.AssemblyLinearVelocity = (targetPos - ball.Position).Unit * 50
                    end
                end


            elseif SaveData.Settings.DKay_OrbitActive then
                if wasKeepaway then wasKeepaway = false end 
                local timeOffset = os.clock() * SaveData.Settings.DKay_OrbitSpeed
                local baseOffsetX = math.cos(timeOffset) * SaveData.Settings.DKay_OrbitDistance
                local baseOffsetZ = math.sin(timeOffset) * SaveData.Settings.DKay_OrbitDistance
                
                local targetOrbitPos = root.Position + Vector3.new(baseOffsetX, 1.5, baseOffsetZ)
                local repulsionVector = Vector3.zero
                local enemies = getEnemyModels()
                
                for _, enemyChar in pairs(enemies) do
                    local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart") or enemyChar:FindFirstChild("Torso")
                    if enemyRoot then
                        local dist = (targetOrbitPos - enemyRoot.Position).Magnitude
                        if dist < SaveData.Settings.DKay_EvasionRadius then
                            local pushDir = (targetOrbitPos - enemyRoot.Position).Unit
                            local pushStrength = (SaveData.Settings.DKay_EvasionRadius - dist) * 1.25 
                            repulsionVector = repulsionVector + (pushDir * pushStrength)
                        end
                    end
                end
                
                local finalPos = targetOrbitPos + repulsionVector
                for i, oball in ipairs(ownedBalls) do
                    local angleOffset = (math.pi * 2 / #ownedBalls) * i
                    local spread = #ownedBalls > 1 and Vector3.new(math.cos(angleOffset)*2, 0, math.sin(angleOffset)*2) or Vector3.zero
                    oball:PivotTo(CFrame.new(finalPos + spread))
                    oball.AssemblyLinearVelocity = Vector3.zero 
                end
            else
                if wasKeepaway then
                    wasKeepaway = false
                    if SaveData.Settings.DKay_KeepawayDropMode == "Teleport" then
                        for _, oball in ipairs(ownedBalls) do
                            oball.CFrame = root.CFrame * CFrame.new(0, -1.5, -1.5)
                            oball.AssemblyLinearVelocity = Vector3.zero
                        end
                    end
                end
            end
        end
    else
        IsAimbotting = false; ShotStartTime = 0; StartPos = nil; CachedCharge = 0; wasKeepaway = false
    end
end))


