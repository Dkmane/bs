        SaveData.Settings.SavedJoins = 0
        SaveData.Settings.SavedPlaytime = 0
        SaveData.Settings.StartOfDayExp = l_LocalPlayer:GetAttribute(XP_ATTR) or 0
        SaveData.Settings.LastResetTimestamp = os.time()
    end
end


