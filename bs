local function DeepCopy(t)
    local copy = {}
    for k, v in pairs(t) do copy[k] = (type(v) == "table") and DeepCopy(v) or v end
    return copy
end


local function LoadAllData()
    if isfile and isfile(DATA_FILE) then
        local success, decoded = pcall(function() return s_HttpService:JSONDecode(readfile(DATA_FILE)) end)
        if success and decoded.Settings then
            
            -- [[ DATA MIGRATION: Fix the old setting name seamlessly ]]
            if decoded.Settings.DisableDKayX ~= nil then
                -- 1. Move the old value to the new 'Blatant' key
                decoded.Settings.Blatant = decoded.Settings.DisableDKayX
                -- 2. Erase the old key so it doesn't cause future conflicts
                decoded.Settings.DisableDKayX = nil
                
                -- 3. Force an instant save so the JSON file on their computer is permanently updated
                if writefile then
                    pcall(function() writefile(DATA_FILE, s_HttpService:JSONEncode(decoded)) end)
                end
            end
            
            SaveData = decoded
            for k, v in pairs(DEFAULT_SETTINGS) do 
                if SaveData.Settings[k] == nil then SaveData.Settings[k] = v end 
            end
        else
            SaveData.Settings = DeepCopy(DEFAULT_SETTINGS)
            SaveData.Targets = DeepCopy(DEFAULT_TARGETS)
        end
    else
        SaveData.Settings = DeepCopy(DEFAULT_SETTINGS)
        SaveData.Targets = DeepCopy(DEFAULT_TARGETS)
    end
    
    local lastDate = os.date("!*t", SaveData.Settings.LastResetTimestamp or 0)
    local currentDate = os.date("!*t")
    if lastDate.day ~= currentDate.day or lastDate.month ~= currentDate.month or lastDate.year ~= currentDate.year then
        SaveData.Settings.SavedWins = 0
        SaveData.Settings.SavedLosses = 0
        SaveData.Settings.SavedAvoided = 0
