        local wantMaxPower = (targetType == "Goal" and SaveData.Settings.GoalAutoMaxPower) or (targetType == "Teammate" and SaveData.Settings.TeamAutoMaxPower)
        
        if payload and payload.Active and payload.Charge and payload.Charge >= requiredCharge then
            local validShot = false
            local shotMode = (targetType == "Goal" and SaveData.Settings.GoalAimShotType or SaveData.Settings.TeammateAimShotType)
            
