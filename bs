-- LOOSER auto dribble: reacts faster, scans only nearby enemies (within scan radius)
local DRIBBLE_SCAN_RADIUS = 20
local DRIBBLE_COOLDOWN_STRICT = 0.9


local function evaluateDribbleThreat(enemyChar, entityObject, mySide, hrp)
    local enemySide = enemyChar:GetAttribute("IsHomeOrAway") or (entityObject and entityObject:GetAttribute("IsHomeOrAway"))
    if enemySide == mySide then return false end
    
    local enemyHrp = enemyChar:FindFirstChild("HumanoidRootPart")
    if not enemyHrp then return false end


    local myPos = hrp.Position
    local enemyPos = enemyHrp.Position
    local dist = (myPos - enemyPos).Magnitude
    
    if dist > DRIBBLE_SCAN_RADIUS then return false end


    local tackleAttr = (type(r_Attributes) == "table" and r_Attributes.Agents and r_Attributes.Agents.IsTackling) or "IsTackling"
    local isTackling = entityObject:GetAttribute(tackleAttr) == true or enemyChar:GetAttribute(tackleAttr) == true


    if isTackling then return true end


    -- Removed: "enemy facing me and close" check was too eager, causing
    -- dribbles when enemies happened to be walking past.
    -- Keep: tackle animation check (reliable signal) + cone check.
    local enemyLook = enemyHrp.CFrame.LookVector
    local rightVector = enemyHrp.CFrame.RightVector
    local offsetDist = math.abs((myPos - enemyPos):Dot(rightVector))
    local forwardDist = (myPos - enemyPos):Dot(enemyLook)
    if forwardDist > -2 and forwardDist < 16 and offsetDist < 6 then return true end


    return false
end


local function HandleAutoDribble()
    if not SaveData.Settings.AutoDribbleEnabled then return end
    local char = l_LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not l_LocalPlayer:GetAttribute("HasBall") then return end
    local mySide = getMySide()
    if not mySide then return end


    local now = tick()
    local currentCooldownState = false
    if ActionController then pcall(function() currentCooldownState = ActionController:IsOnCooldown("Dribble") end) end
    
    if currentCooldownState and not dribble_wasOnCooldown then dribble_lastTriggerTime = now end
    dribble_wasOnCooldown = currentCooldownState


    local isOnCooldown = currentCooldownState or (now - dribble_lastTriggerTime) < DRIBBLE_COOLDOWN_STRICT
    local isInDribbleBuffer = (now - dribble_lastTriggerTime) < SaveData.Settings.KickBuffer


    local threatDetected = false
    for _, player in pairs(s_Players:GetPlayers()) do
        if player ~= l_LocalPlayer and player.Character then
            local enemyHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if enemyHrp and (enemyHrp.Position - hrp.Position).Magnitude <= DRIBBLE_SCAN_RADIUS then
                if evaluateDribbleThreat(player.Character, player, mySide, hrp) then threatDetected = true break end
            end
        end
    end


    if not threatDetected then
        local agentFolder = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Agents")
        if agentFolder then
            for _, npc in pairs(agentFolder:GetChildren()) do
                local npcHrp = npc:FindFirstChild("HumanoidRootPart")
                if npcHrp and (npcHrp.Position - hrp.Position).Magnitude <= DRIBBLE_SCAN_RADIUS then
                    if evaluateDribbleThreat(npc, npc, mySide, hrp) then threatDetected = true break end
                end
            end
        end
    end


    if threatDetected then
        if isOnCooldown then
            if SaveData.Settings.BackupKick and not isInDribbleBuffer then triggerQuickKick() end
        else triggerDribble(hrp) end
    end
end


-- // ADVANCED AUTO GK & JUMP FIX //
-- Reduced from 2.5s → 1.5s so GK doesn't go unresponsive after a dive.
local GK_COOLDOWN_TIME = 1.5
local GK_JUMP_COOLDOWN = 0.8
local lastDiveTime = 0
local lastJumpTime = 0


local function getBall()
    local tagged = s_CollectionService:GetTagged("Football")
    if #tagged > 0 then return tagged[1] end
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and (v.Name:lower() == "football" or v.Name:lower() == "soccerball") then return v end
    end
    return nil
end


local function getPlayerRole()
    local attrs = {"TeamPosition", "Position", "Role"}
    for _, attr in ipairs(attrs) do
        local val = l_LocalPlayer:GetAttribute(attr)
        if val then return tostring(val) end
    end
    for _, attr in ipairs(attrs) do
        local val = l_LocalPlayer:FindFirstChild(attr)
        if val and val:IsA("StringValue") then return val.Value end
    end
    return "Unknown"
end


local function autoGkDive(targetPos, rootPart)
    if not ActionController then return end
    if ActionController.IsOnCooldown and ActionController:IsOnCooldown("Leap") then return end
    if tick() - lastDiveTime < GK_COOLDOWN_TIME then return end


    local toball   = targetPos - rootPart.Position
    local forward  = rootPart.CFrame.LookVector
    local rightVec = rootPart.CFrame.RightVector


    local forwardDot = toball:Dot(forward)
    local rightDot   = toball:Dot(rightVec)


    if math.abs(rightDot) > math.abs(forwardDot) * 0.4 then
        local diveDirection = rightDot > 0 and "Right" or "Left"
        local lookCF = CFrame.lookAt(rootPart.Position, Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z))
        rootPart.CFrame = lookCF
        pcall(function() ActionController:PerformAction("Leap", diveDirection) end)
        lastDiveTime = tick()
    else
        -- Forward Dive Replacement (Jumps instantly with custom linear velocity)
        local humanoid = rootPart.Parent and rootPart.Parent:FindFirstChildOfClass("Humanoid")
        if humanoid and (tick() - lastJumpTime) >= GK_JUMP_COOLDOWN then
            rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, humanoid.JumpPower > 0 and humanoid.JumpPower or 50, rootPart.AssemblyLinearVelocity.Z)
            lastJumpTime = tick()
        end
    end
end


local function HandleAutoGK()
    if not SaveData.Settings.AutoGK then return end
    local role = getPlayerRole()
    if role ~= "GK" and role ~= "Goalkeeper" then return end


    local ball = getBall()
    local char = l_LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not ball or not rootPart then return end


    local ballY = ball.Position.Y
    local chestY = rootPart.Position.Y + 1.0 -- Lowered threshold to waist/chest height


    -- IGNORE if ball is very high (a lofted shot / clearance) — Y > 6.5 absolute
    if ballY > 6.5 then return end


    local distance = (ball.Position - rootPart.Position).Magnitude
    local ownerName = ball:GetAttribute("NetworkOwner")
    local isMe = (ownerName == l_LocalPlayer.Name)
    local isLoose = (not ownerName or ownerName == "")
    local isOpponent = false


    if ownerName and not isMe and not isLoose then
        local p = s_Players:FindFirstChild(ownerName)
        if p and (not p.Team or (l_LocalPlayer.Team and p.Team ~= l_LocalPlayer.Team)) then isOpponent = true end
    end


    -- Velocity prediction: also react if a fast ball is heading toward us
    local ballVel = ball.AssemblyLinearVelocity
    local ballApproaching = false
    if ballVel.Magnitude > 8 then
        local toRoot = (rootPart.Position - ball.Position)
        if ballVel.Unit:Dot(toRoot.Unit) > 0.5 then
            -- Predict where ball will be in 0.4s
            if (ball.Position + ballVel * 0.4 - rootPart.Position).Magnitude <= 18 then
                ballApproaching = true
            end
        end
    end

    local inRange = (isOpponent and distance <= 18) or (isLoose and distance <= 16) or ballApproaching

    if inRange then
        -- Jump if ball is above chest height
        if ballY > chestY and humanoid and (tick() - lastJumpTime) >= GK_JUMP_COOLDOWN then
            rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, humanoid.JumpPower > 0 and humanoid.JumpPower or 50, rootPart.AssemblyLinearVelocity.Z)
            lastJumpTime = tick()
        end
        autoGkDive(ball.Position, rootPart)
    end
end


