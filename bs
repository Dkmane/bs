    local moveDirection = humanoid.MoveDirection
    if moveDirection.Magnitude < 0.1 then return r_Enums.Direction.Forward end


    local camera = workspace.CurrentCamera
    local lookVector = camera.CFrame.LookVector
    local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
    local dot = flatLook:Dot(moveDirection)
    local angle = math.deg(math.acos(dot))


    if angle < 45 then return r_Enums.Direction.Forward
    elseif angle < 135 then return (moveDirection:Dot(Vector3.new(flatLook.Z, 0, -flatLook.X)) < 0) and r_Enums.Direction.Right or r_Enums.Direction.Left
    else return r_Enums.Direction.Forward end
end


local function triggerDribble(hrp)
    if ActionController and ActionController:IsOnCooldown("Dribble") then return end
    dribble_lastTriggerTime = tick()
    if ActionController then ActionController:RequestAction("Dribble") end
    
    if r_Attributes and r_Attributes.Agents then l_LocalPlayer:SetAttribute(r_Attributes.Agents.IsEvadingClient, true) end
    if SoundController then SoundController:PlaySound(s_ReplicatedStorage.Assets.Sounds.Character.Dash) end
    
    local direction = getDribbleDirection()
    local evadeDuration = (r_Agent and r_Agent.Actions and r_Agent.Actions.EvadeDuration) or 0.35


    if r_Enums and direction == r_Enums.Direction.Forward then
        local animId = l_LocalPlayer:GetAttribute((r_Attributes and r_Attributes.Player.EquippedDribble) or "EquippedDribble") or (r_Agent and r_Agent.DefaultItems.ForwardDribble)
        local animObj = animId and s_ReplicatedStorage.Assets.Items.Dribbles:FindFirstChild(animId)
        if animObj and AnimationController then
            local speed = AnimationController:LoadAnimationFromPlayer(animObj).Length / evadeDuration
            AnimationController:PlayAnimationFromPlayer(l_LocalPlayer, animObj, nil, nil, math.max(speed, 1.38))
        end
    else
        local dashVec = (r_Enums and direction == r_Enums.Direction.Right and 1 or -1)
        local moveVec = workspace.CurrentCamera.CFrame.RightVector * dashVec
        local evadeLifetime = (r_Movement and r_Movement.Movers.EvadeMoverLifetime) or 0.3
        local evadeVel = (r_Movement and r_Movement.Movers.EvadeMoverMaxVelocity) or 45
        local targetPos = hrp.Position + (Vector3.new(moveVec.X, 0, moveVec.Z).Unit * (evadeLifetime * evadeVel))
        
        local evadePos = hrp:FindFirstChild("EvadePosition")
        if evadePos then
            evadePos.Position = targetPos
            evadePos.Enabled = true
            task.delay(evadeLifetime, function() evadePos.Enabled = false end)
        end
    end
end


