local function triggerBlockedVisual()
    local now = os.clock()
    if now - LastBlockTime > 0.1 then
        LastBlockTime = now
        -- Asynchronous execution (task.defer) added back to prevent UI yielding from freezing the game.
        task.defer(function()
            setStatus("Lagspike blocked...", Color3.fromRGB(255, 100, 100), true)
        end)
    end
end


-- // HYPER-OPTIMIZED CORE HOOK // --
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if not UserSettings.AntiSpamEnabled then return oldNamecall(self, ...) end
    
    if getnamecallmethod() == "FireServer" then
        local p1 = (...) 
        
        -- string.byte checks the string directly without relying on self.Name first
        local isUUIDSpam = (type(p1) == "string" and #p1 == 36 and string.byte(p1, 9) == 45)
        
        -- Short-circuits: If it's a UUID, it skips checking self.Name entirely
        if isUUIDSpam or self.Name == "FireClientTouch" or self.Name == "ClientTouch" then
            local now = os.clock()
            if now - LastTouchTime < Config.ThrottleMs then
                triggerBlockedVisual()
                return -- Blocks the Remote Fire instantly
            end
            LastTouchTime = now
        end
    end
    
    return oldNamecall(self, ...)
end)


getgenv().DKayAntiLag_Unload = function()
    for _, loop in pairs(Loops) do
        if loop then task.cancel(loop) end
    end
    if ScreenGui then ScreenGui:Destroy() end
    if oldNamecall then hookmetamethod(game, "__namecall", oldNamecall) end
    getgenv().DKayAntiLag_Unload = nil
end



