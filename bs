local function makeToggleDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos, movedFar
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            movedFar = false
            dragStart = input.Position
            startPos = guiObject.Position
            
            local conn
            conn = input.Changed:Connect(function() 
                if input.UserInputState == Enum.UserInputState.End then 
                    dragging = false 
                    conn:Disconnect()
                
                    if movedFar then
                        local screenSize = UI.AbsoluteSize
                        if screenSize.X > 0 and screenSize.Y > 0 then
                            local finalX = guiObject.AbsolutePosition.X / screenSize.X
                            local finalY = guiObject.AbsolutePosition.Y / screenSize.Y
                            guiObject.Position = UDim2.new(finalX, 0, finalY, 0)
                            SaveData.Settings.TogglePosX = finalX
                            SaveData.Settings.TogglePosY = finalY
                            SaveAllData()
                        end
                    else
                        MainFrame.Visible = not MainFrame.Visible
                        ToggleStroke.Color = MainFrame.Visible and Color3.fromRGB(60, 150, 255) or Color3.fromRGB(80, 80, 80)
                    end
                end 
            end)
        end
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then 
            dragInput = input 
        end
    end)
    s_UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and not SaveData.Settings.ToggleLocked then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then movedFar = true end
            if movedFar then
                guiObject.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end)
end
