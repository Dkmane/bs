    for key, btn in pairs(UI_Registry.Toggles) do if SaveData.Settings[key] ~= nil then local s = SaveData.Settings[key]; btn.Text = s and "ON" or "OFF"; btn.TextColor3 = s and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100) end end
    for key, btn in pairs(UI_Registry.Cyclers) do if SaveData.Settings[key] ~= nil then btn.Text = tostring(SaveData.Settings[key]) end end
    for key, elements in pairs(UI_Registry.Advanced) do
        local s = SaveData.Settings[key]; elements.Main.Text = s and "ON" or "OFF"; elements.Main.TextColor3 = s and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
        local bActive = SaveData.Bubbles[key]; elements.Bub.TextColor3 = bActive and Color3.fromRGB(100, 255, 255) or Color3.fromRGB(150, 150, 150)
        local kb = SaveData.Keybinds[key]; elements.Key.Text = kb and string.sub(kb, 1, 3):upper() or "KEY"; elements.Key.TextColor3 = kb and Color3.fromRGB(255, 255, 100) or Color3.fromRGB(150, 150, 150)
    end
end


