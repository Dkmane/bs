local function getTimestamp12h()
    local t = os.date("*t")
    local hour = t.hour % 12
    if hour == 0 then hour = 12 end
    return string.format("[%02d:%02d %02ds %s]", hour, t.min, t.sec, t.hour >= 12 and "Pm" or "Am")
end


local function writeLogHeader()
    local playtime = SaveData.Settings.SavedPlaytime or 0
    local header = "--- SLS DAILY LOG | USER: " .. l_LocalPlayer.Name .. " ---\n"
    header = header .. "TOTAL RUNTIME TODAY: " .. string.format("%dh %dm %ds", math.floor(playtime/3600), math.floor((playtime%3600)/60), playtime%60) .. "\n------------------------------------------\n"
    pcall(function() writefile(LOG_FILE, header) end)
end


local function appendToLog(action, score)
    if not isfile(LOG_FILE) then writeLogHeader() end
    local timeInLobby = os.time() - lobbyStartTime
    local scoreStr = score and (" | Score: " .. score) or ""
    local entry = string.format("%s User: %s | Action: %s%s | Lobby Time: %ds\n", getTimestamp12h(), l_LocalPlayer.Name, action, scoreStr, timeInLobby)
    pcall(function() appendfile(LOG_FILE, entry) end)
end


local function smartHop()
    local success, result = pcall(function() return s_HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100")) end)
    if success and result.data then
        local candidates = {}
        local min, max = SaveData.Settings.MinServers, SaveData.Settings.MaxServers
        local perfect = (min + max) / 2
        for _, s in pairs(result.data) do if s.playing >= min and s.playing <= max and s.id ~= game.JobId then table.insert(candidates, s) end end
        table.sort(candidates, function(a, b) return math.abs(a.playing - perfect) < math.abs(b.playing - perfect) end)
        if #candidates > 0 then s_TeleportService:TeleportToPlaceInstance(game.PlaceId, candidates[1].id)
        else for _, s in pairs(result.data) do if s.playing >= 1 and s.playing < 12 and s.id ~= game.JobId then s_TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id) break end end end
    end
end


local function getRankName(xp)
    if xp < 333 then return "Bronze I" elseif xp < 666 then return "Bronze II" elseif xp < 1000 then return "Bronze III"
    elseif xp < 1333 then return "Silver I" elseif xp < 1666 then return "Silver II" elseif xp < 2000 then return "Silver III"
    elseif xp < 2333 then return "Gold I" elseif xp < 2666 then return "Gold II" elseif xp < 3000 then return "Gold III"
    elseif xp < 3333 then return "Platinum I" elseif xp < 3666 then return "Platinum II" elseif xp < 4000 then return "Platinum III"
    elseif xp < 4333 then return "Elite I" elseif xp < 4666 then return "Elite II" elseif xp < 5000 then return "Elite III"
    elseif xp < 5333 then return "Champion I" elseif xp < 5666 then return "Champion II" elseif xp < 6000 then return "Champion III"
    else return "Icon VI" end
end


