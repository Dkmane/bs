local function getBestTeammateDir()
    local myTeam = l_LocalPlayer:GetAttribute("IsHomeOrAway") or (l_LocalPlayer.Team and l_LocalPlayer.Team.Name)
    local bestPlr, bestDot = nil, -1
    for _, plr in ipairs(s_Players:GetPlayers()) do
        if plr ~= l_LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local theirTeam = plr:GetAttribute("IsHomeOrAway") or (plr.Team and plr.Team.Name)
            if theirTeam == myTeam then
                local dir = (plr.Character.HumanoidRootPart.Position - l_Camera.CFrame.Position).Unit
                local dot = l_Camera.CFrame.LookVector:Dot(dir)
                if dot > bestDot then bestDot = dot; bestPlr = plr end
            end
        end
    end
    return bestPlr
end


