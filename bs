        local kOn, pOn = ShotData.Settings.KickEnabled, ShotData.Settings.PassEnabled
        if kOn and pOn then bub.Text = "MSTR\nON"; bub.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
        elseif not kOn and not pOn then bub.Text = "MSTR\nOFF"; bub.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        else bub.Text = "MSTR\nMIX"; bub.BackgroundColor3 = Color3.fromRGB(180, 140, 60) end
        
        bub.MouseButton1Click:Connect(function()
            if bub:GetAttribute("MovedFar") then return end 
            local isAnyOn = (ShotData.Settings.KickEnabled or ShotData.Settings.PassEnabled)
            if isAnyOn then
                ShotData.Settings.StoredKick = ShotData.Settings.KickEnabled
                ShotData.Settings.StoredPass = ShotData.Settings.PassEnabled
                ShotData.Settings.KickEnabled = false
                ShotData.Settings.PassEnabled = false
            else
                ShotData.Settings.KickEnabled = ShotData.Settings.StoredKick; if ShotData.Settings.KickEnabled == nil then ShotData.Settings.KickEnabled = true end
                ShotData.Settings.PassEnabled = ShotData.Settings.StoredPass; if ShotData.Settings.PassEnabled == nil then ShotData.Settings.PassEnabled = true end
            end
            SaveShotData(); getgenv().DKay_SyncAimUI()
        end)
    else
        local fKey = (configKey == "KickEnabled") and "KickFocus" or "PassFocus"
        local f = ShotData.Settings[fKey] or "Goal"
        bub.Text = shortName .. "\n" .. f
        bub.BackgroundColor3 = (f == "Goal") and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(60, 140, 180)
        
        bub.MouseButton1Click:Connect(function()
            if bub:GetAttribute("MovedFar") then return end 
            local isCurrentlyGoal = (ShotData.Settings[fKey] == "Goal")
            local newFocus = isCurrentlyGoal and "Teammate" or "Goal"
            ShotData.Settings[fKey] = newFocus
            bub.Text = shortName .. "\n" .. newFocus
            bub.BackgroundColor3 = (newFocus == "Goal") and Color3.fromRGB(180, 60, 60) or Color3.fromRGB(60, 140, 180)
            SaveShotData(); getgenv().DKay_SyncAimUI()
        end)
    end


    local dragging, dragInput, dragStart, startPos, movedFar
    bub.InputBegan:Connect(function(input)
        if ShotData.Settings.LockBubbles then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; movedFar = false; bub:SetAttribute("MovedFar", false); dragStart = input.Position; startPos = bub.Position
            local conn; conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false; conn:Disconnect()
                    if movedFar then
                        local sz = BubbleUI.AbsoluteSize
                        if sz.X > 0 and sz.Y > 0 then ShotData.Positions[configKey] = {X = bub.AbsolutePosition.X / sz.X, Y = bub.AbsolutePosition.Y / sz.Y}; SaveShotData() end
                    end
                end
            end)
        end
    end)
    bub.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end end)
    s_UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and not ShotData.Settings.LockBubbles then
            local delta = input.Position - dragStart; if delta.Magnitude > 5 then movedFar = true; bub:SetAttribute("MovedFar", true) end
            if movedFar then bub.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end
        end
    end)
    ActiveBubbles[configKey] = bub
end


local function RemoveFloatingBubble(configKey)
