local function selectGoalTargetShot(targetList, mode, playerPos, camCFrame, fov, gkPos, farThreshold, nearMode)
    if not targetList or #targetList == 0 then return nil end
    local validTargets = {}
    for _, pos in ipairs(targetList) do
        local dir = (pos - camCFrame.Position).Unit
        local angle = math.acos(math.clamp(camCFrame.LookVector:Dot(dir), -1, 1))
        if math.deg(angle) <= (fov / 2) then table.insert(validTargets, {pos = pos, dist = (pos - playerPos).Magnitude, angle = angle}) end
    end
    if #validTargets == 0 then return nil end
    
    local minPlayerDist = math.huge
    for _, d in ipairs(validTargets) do if d.dist < minPlayerDist then minPlayerDist = d.dist end end


    local bestTarget, bestVal = validTargets[1].pos, (mode == "Far" or mode == "Smart") and -math.huge or math.huge
    
    if mode == "Nearest" then
        for _, data in ipairs(validTargets) do if data.dist < bestVal then bestVal = data.dist; bestTarget = data.pos end end
    elseif mode == "Far" then
        for _, data in ipairs(validTargets) do if data.dist > bestVal then bestVal = data.dist; bestTarget = data.pos end end
    elseif mode == "Angle" then
        for _, data in ipairs(validTargets) do if data.angle < bestVal then bestVal = data.angle; bestTarget = data.pos end end
    elseif mode == "Smart" then
        if minPlayerDist <= farThreshold then
            bestVal = math.huge
            for _, data in ipairs(validTargets) do
                local val = (nearMode == "Distance") and data.dist or data.angle
                if val < bestVal then bestVal = val; bestTarget = data.pos end
            end
        else
            if gkPos then
                bestVal = -1
                for _, data in ipairs(validTargets) do
                    local distToGk = (data.pos - gkPos).Magnitude
                    if distToGk > bestVal then bestVal = distToGk; bestTarget = data.pos end
                end
            else
                bestVal = math.huge
                for _, data in ipairs(validTargets) do
                    local val = (nearMode == "Distance") and data.dist or data.angle
                    if val < bestVal then bestVal = val; bestTarget = data.pos end
                end
            end
        end
    end 
    return bestTarget
end


local function getBestTeammateShot(maxRange, mode, fov, myTeam)
    local hrp = l_LocalPlayer.Character and l_LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local validTeammates, enemyPositions, camCFrame = {}, {}, l_Camera.CFrame
    for _, plr in pairs(s_Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = plr.Character.HumanoidRootPart
            local theirTeam = plr:GetAttribute("IsHomeOrAway") or plr.Character:GetAttribute("IsHomeOrAway")
            if theirTeam == myTeam and plr ~= l_LocalPlayer then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= maxRange then
                    local dir = (targetHrp.Position - camCFrame.Position).Unit
                    local angle = math.acos(math.clamp(camCFrame.LookVector:Dot(dir), -1, 1))
                    if math.deg(angle) <= (fov / 2) then table.insert(validTeammates, {pos = targetHrp.Position, dist = dist, angle = angle}) end
                end
            elseif theirTeam ~= myTeam and theirTeam ~= nil then table.insert(enemyPositions, targetHrp.Position) end
        end
    end
    if #validTeammates == 0 then return nil end
    local bestPos, bestVal = validTeammates[1].pos, (mode == "Far" or mode == "Smart") and -math.huge or math.huge
    for _, data in ipairs(validTeammates) do
        if mode == "Nearest" and data.dist < bestVal then bestVal = data.dist; bestPos = data.pos
        elseif mode == "Far" and data.dist > bestVal then bestVal = data.dist; bestPos = data.pos
        elseif mode == "Angle" and data.angle < bestVal then bestVal = data.angle; bestPos = data.pos
        elseif mode == "Smart" then
            local closestEnemyDist = math.huge
            for _, ePos in ipairs(enemyPositions) do local eDist = (data.pos - ePos).Magnitude if eDist < closestEnemyDist then closestEnemyDist = eDist end end
            if closestEnemyDist == math.huge then closestEnemyDist = data.angle * -1 end 
            if closestEnemyDist > bestVal then bestVal = closestEnemyDist; bestPos = data.pos end
        end
    end return bestPos
end


local function updateShotVisuals()
    ShotVisualFolder:ClearAllChildren(); ActiveShotMarkers = {}
    
    for team, actions in pairs(ShotData.Targets) do
        for action, locations in pairs(actions) do
            for i, loc in ipairs(locations) do
                local targetPart = findCorrectPartShot(loc.PartName, Vector3.new(loc.WorldPos.X, loc.WorldPos.Y, loc.WorldPos.Z))
                local actualPos = targetPart and targetPart.CFrame:PointToWorldSpace(Vector3.new(loc.Off.X, loc.Off.Y, loc.Off.Z)) or Vector3.new(loc.WorldPos.X, loc.WorldPos.Y, loc.WorldPos.Z)


                local part = Instance.new("Part")
                part.Shape, part.Size, part.Position, part.Anchored, part.CanCollide = Enum.PartType.Ball, Vector3.new(1.5, 1.5, 1.5), actualPos, true, false
                part.Material, part.Transparency = Enum.Material.Neon, ShotData.Settings.TargetTransparency
                part.Color = (team == "Away") and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 100, 255)
                
                if ShotData.Settings.TargetShowLabels then
                    local bg = Instance.new("BillboardGui", part); bg.Size, bg.AlwaysOnTop = UDim2.new(0, 100, 0, 30), true
                    local txt = Instance.new("TextLabel", bg); txt.Size, txt.BackgroundTransparency, txt.Text, txt.TextStrokeTransparency, txt.Font, txt.TextSize = UDim2.new(1, 0, 1, 0), 1, team .. " " .. action .. " [" .. i .. "]", 0, Enum.Font.GothamBold, 10
                    
                    if team == ShotData.Settings.TargetEditTeam and action == ShotData.Settings.TargetEditAction and i == ShotData.Settings.TargetEditIndex then
                        txt.TextColor3 = Color3.fromRGB(255, 50, 50)
                    else
                        txt.TextColor3 = Color3.new(1, 1, 1)
                    end
                end
                part.Parent = ShotVisualFolder
                table.insert(ActiveShotMarkers, { Part = part, TargetPart = targetPart, Data = loc })
            end
        end
    end
end


