            if configKey == "DKay_JediGrabActive" then 
                getgenv().JediBubbleHeld = true 
                if SaveData.Settings.DKay_JediMode == "Hold" then bubble.BackgroundColor3 = Color3.fromRGB(0, 155, 80) end
            end
        end
    end)
    bubble.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if configKey == "DKay_JediGrabActive" then 
                getgenv().JediBubbleHeld = false 
                if SaveData.Settings.DKay_JediMode == "Hold" then bubble.BackgroundColor3 = Color3.fromRGB(20, 20, 25) end
            end
        end
    end)
    
    local bDragging, bDragInput, bDragStart, bStartPos, bMovedFar
    bubble.InputBegan:Connect(function(input)
        if SaveData.Settings.BubblesLocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            bDragging = true; bMovedFar = false; bDragStart = input.Position; bStartPos = bubble.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    bDragging = false; conn:Disconnect()
                    if bMovedFar then
                        local parentSize = FloatUI.AbsoluteSize
                        if parentSize.X > 0 and parentSize.Y > 0 then
                            SaveData.Positions[configKey] = {X = bubble.AbsolutePosition.X / parentSize.X, Y = bubble.AbsolutePosition.Y / parentSize.Y}
                            SaveAllData()
                        end
                    end
                end
            end)
        end
    end)
    bubble.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then bDragInput = input end end)
    s_UserInputService.InputChanged:Connect(function(input)
        if input == bDragInput and bDragging and not SaveData.Settings.BubblesLocked then
            local delta = input.Position - bDragStart; if delta.Magnitude > 5 then bMovedFar = true end
            if bMovedFar then bubble.Position = UDim2.new(bStartPos.X.Scale, bStartPos.X.Offset + delta.X, bStartPos.Y.Scale, bStartPos.Y.Offset + delta.Y) end
        end
    end)
    
    ActiveBubbles[configKey] = bubble
    bubble.Visible = true
end


