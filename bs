local function getClosestFootballs()
    local myTeam = l_LocalPlayer:GetAttribute("IsHomeOrAway") or (l_LocalPlayer.Team and l_LocalPlayer.Team.Name)
    if myTeam ~= "Home" and myTeam ~= "Away" then return {} end
    
    local myChar = l_LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return {} end
    
    local balls = s_CollectionService:GetTagged("Football")
    if #balls == 0 then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower() == "football" or v.Name:lower() == "soccerball") then table.insert(balls, v) end
        end
    end
    local sortedBalls = {}
    for _, ball in ipairs(balls) do
        if ball:IsA("BasePart") then table.insert(sortedBalls, {ball = ball, dist = (ball.Position - myHrp.Position).Magnitude}) end
    end
    table.sort(sortedBalls, function(a, b) return a.dist < b.dist end)
    
    local res = {}
    for i=1, math.min(#sortedBalls, SaveData.Settings.MultiBallLimit) do table.insert(res, sortedBalls[i].ball) end
    return res
end


