local function BoostPerformance(enableTextureRemoval)
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Reflectance = 0; v.CastShadow = false
            if enableTextureRemoval and v.Size.Magnitude > SizeThreshold then
                if not isWhitelisted(v) then v.Material = Enum.Material.SmoothPlastic end
            end
        elseif v:IsA("Decal") or v:IsA("Texture") then
            if enableTextureRemoval and v.Parent and v.Parent:IsA("BasePart") and v.Parent.Size.Magnitude > SizeThreshold then
                if not isWhitelisted(v) then v:Destroy() end
            end
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
            if not isWhitelisted(v) then v.Enabled = false else v.Enabled = true end
        end
    end
    for _, effect in pairs(s_Lighting:GetChildren()) do
        if effect:IsA("PostProcessEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") then
            effect.Enabled = false
        end
    end
end


