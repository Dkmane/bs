local function RefreshMarkers()
    if Destructing then return end
    for _, data in pairs(HubState.ActiveMarkers) do data.MarkerPart:Destroy() end
    HubState.ActiveMarkers = {}
    
    local team = getMySide()
    if not team or not SaveData.Targets[team] then return end
    
    for i, data in pairs(SaveData.Targets[team]) do
        local targetPart = findCorrectPart(data.PartName, Vector3.new(data.WorldPos[1], data.WorldPos[2], data.WorldPos[3]))
        if targetPart then
            local p = Instance.new("Part", workspace)
            p.Size = Vector3.new(1.5, 1.5, 1.5)
            p.Shape, p.Anchored, p.CanCollide = Enum.PartType.Ball, true, false
            p.Color, p.Material = l_LocalPlayer.TeamColor.Color, "Neon"
            p.Transparency = SaveData.Settings.ShowIndicators and 0.5 or 1
            table.insert(HubState.ActiveMarkers, {MarkerPart = p, TargetPart = targetPart, Offset = Vector3.new(data.Off[1], data.Off[2], data.Off[3]), DataIndex = i })
        end
    end
end


-- // AIM LOGIC //
local function getBestTargetPos()
    local char = l_LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or #HubState.ActiveMarkers == 0 then return nil end


    local bars = getOpponentGoalBars()
    if not bars then return nil end
    
    local goalCF, goalSize = bars:GetBoundingBox()
    local relPos = goalCF:PointToObjectSpace(hrp.Position)
    local halfWidth = (goalSize.X / 2) + SaveData.Settings.SafeZonePadding
    if math.abs(relPos.X) > halfWidth then return nil end


    local allPotentialTargets = {}
    local minPlayerDist = math.huge
    local center = Vector2.new(l_Camera.ViewportSize.X / 2, l_Camera.ViewportSize.Y / 2)


    local anyInRange = false
    for _, data in pairs(HubState.ActiveMarkers) do
        if data.TargetPart then
            local worldPos = data.TargetPart.CFrame:PointToWorldSpace(data.Offset)
            local distToMe = (worldPos - hrp.Position).Magnitude
            if distToMe <= SaveData.Settings.MaxRange then anyInRange = true break end
        end
    end


    for _, data in pairs(HubState.ActiveMarkers) do
        if data.TargetPart then
            local worldPos = data.TargetPart.CFrame:PointToWorldSpace(data.Offset)
            local distToMe = (worldPos - hrp.Position).Magnitude
            
            if anyInRange then
                local screenPos, onScreen = l_Camera:WorldToViewportPoint(worldPos)
                local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                
                if SaveData.Settings.MaxFOV >= 360 or (onScreen and screenDist <= (SaveData.Settings.MaxFOV * 10)) then
                    if distToMe < minPlayerDist then minPlayerDist = distToMe end
                    table.insert(allPotentialTargets, {pos = worldPos, distMe = distToMe, screenDist = screenDist})
                end
            end
        end
    end


    if #allPotentialTargets == 0 then return nil end
    local mode = SaveData.Settings.AimMode
    
    if mode == "Angle" then
        local bestPos, bestAngle = nil, math.huge
        for _, t in pairs(allPotentialTargets) do if t.screenDist < bestAngle then bestAngle = t.screenDist bestPos = t.pos end end
        return bestPos
    elseif mode == "Distance" then
        local bestPos, closestDist = nil, math.huge
        for _, t in pairs(allPotentialTargets) do if t.distMe < closestDist then closestDist = t.distMe bestPos = t.pos end end
        return bestPos
    else
        local gkPos = getGKPosition()
        if minPlayerDist <= SaveData.Settings.FarModeThreshold then
            if SaveData.Settings.SmartNearMode == "Angle" then
                local bestPos, bestAngle = nil, math.huge
                for _, t in pairs(allPotentialTargets) do if t.screenDist < bestAngle then bestAngle = t.screenDist bestPos = t.pos end end
                return bestPos
            else
                local bestPos, closestDist = nil, math.huge
                for _, t in pairs(allPotentialTargets) do if t.distMe < closestDist then closestDist = t.distMe bestPos = t.pos end end
                return bestPos
            end
        else
            if gkPos then
                local bestPos, maxGkDist = nil, -1
                for _, t in pairs(allPotentialTargets) do
                    local distToGk = (t.pos - gkPos).Magnitude
                    if distToGk > maxGkDist then maxGkDist = distToGk bestPos = t.pos end
                end
                return bestPos
            else
                if SaveData.Settings.SmartNearMode == "Angle" then
                    local bestPos, bestAngle = nil, math.huge
                    for _, t in pairs(allPotentialTargets) do if t.screenDist < bestAngle then bestAngle = t.screenDist bestPos = t.pos end end
                    return bestPos
                else
                    local bestPos, closestDist = nil, math.huge
                    for _, t in pairs(allPotentialTargets) do if t.distMe < closestDist then closestDist = t.distMe bestPos = t.pos end end
                    return bestPos
                end
            end
        end
    end
end


local function getBestTeammatePos()
    local hrp = l_LocalPlayer.Character and l_LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end


    local myTeam = getMySide()
    local potentialTargets = {}
    local center = Vector2.new(l_Camera.ViewportSize.X / 2, l_Camera.ViewportSize.Y / 2)


    for _, plr in pairs(s_Players:GetPlayers()) do
        if plr ~= l_LocalPlayer then
            local char = plr.Character
            local targetHrp = char and char:FindFirstChild("HumanoidRootPart")
            local theirTeam = plr:GetAttribute("IsHomeOrAway") or (char and char:GetAttribute("IsHomeOrAway"))
            
            if targetHrp and theirTeam == myTeam then
                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist <= SaveData.Settings.TeammateMaxRange then
                    local screenPos, onScreen = l_Camera:WorldToViewportPoint(targetHrp.Position)
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    
                    if SaveData.Settings.TeammateMaxFOV >= 360 or (onScreen and screenDist <= (SaveData.Settings.TeammateMaxFOV * 10)) then
                        table.insert(potentialTargets, {pos = targetHrp.Position, distMe = dist, screenDist = screenDist})
                    end
                end
            end
        end
    end
    
    if #potentialTargets == 0 then return nil end
    local bestPos, bestVal = nil, math.huge
    local mode = SaveData.Settings.TeammateAimMode
    
    for _, t in pairs(potentialTargets) do
        local val = (mode == "Nearest") and t.distMe or t.screenDist
        if val < bestVal then bestVal = val bestPos = t.pos end
    end
    return bestPos
end


local function GetAimTarget()
    local hrp = l_LocalPlayer.Character and l_LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end
    
    local minMarkerDist = math.huge
    for _, data in pairs(HubState.ActiveMarkers) do
        if data.TargetPart then
            local worldPos = data.TargetPart.CFrame:PointToWorldSpace(data.Offset)
            local dist = (worldPos - hrp.Position).Magnitude
            if dist < minMarkerDist then minMarkerDist = dist end
        end
    end


    if minMarkerDist <= SaveData.Settings.MaxRange then
        if SaveData.Settings.GoalAimbotMaster and SaveData.Settings.GoalAimActive then return getBestTargetPos(), "Goal" end
    else
        if SaveData.Settings.TeammateAimAssist and SaveData.Settings.TeamAimActive then return getBestTeammatePos(), "Teammate" end
    end
    return nil, nil
end


-- // AUTO TACKLE //
local tackle_lastTackleTime = 0


local function isDownedOrGK(playerChar, playerObj)
    if not playerChar or not playerObj then return true end
    if playerObj:GetAttribute("Tackled") == true or playerChar:GetAttribute("Tackled") == true then return true end
    local pos = playerObj:GetAttribute("TeamPosition")
    local role = playerObj:GetAttribute("TeamRole")
    if pos == "GK" or role == "Goalkeeper" then return true end
    return false
end


local function triggerTackle(enemyHrp)
    local char = l_LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(enemyHrp.Position.X, hrp.Position.Y, enemyHrp.Position.Z))
    
    tackle_lastTackleTime = tick()
    if r_Tackle then pcall(function() r_Tackle.Activate() end)
    elseif ActionController then ActionController:RequestAction("Tackle") end
end


local function evaluateTackleTarget(enemyChar, entityObject, mySide, hrp)
    local enemySide = enemyChar:GetAttribute("IsHomeOrAway") or (entityObject and entityObject:GetAttribute("IsHomeOrAway"))
    if enemySide == mySide then return false end
    
    if isDownedOrGK(enemyChar, entityObject) then return false end


    local isTackling = enemyChar:GetAttribute("IsTackling") or entityObject:GetAttribute("IsTackling") or enemyChar:GetAttribute("Tackling") or entityObject:GetAttribute("Tackling")
    if isTackling then return false end
    
    local isEvading = enemyChar:GetAttribute("IsEvading") or entityObject:GetAttribute("IsEvading") or enemyChar:GetAttribute("Evading") or entityObject:GetAttribute("Evading")
    if isEvading then return false end


    local enemyHasBall = enemyChar:GetAttribute("HasBall") or (entityObject and entityObject:GetAttribute("HasBall"))
    if not enemyHasBall then return false end


    local enemyHrp = enemyChar:FindFirstChild("HumanoidRootPart")
    if not enemyHrp then return false end


    local dist = (hrp.Position - enemyHrp.Position).Magnitude
    if dist <= SaveData.Settings.TackleRadius then return enemyHrp end
    return false
end


local function HandleAutoTackle()
    if not SaveData.Settings.AutoTackleEnabled then return end
    local char = l_LocalPlayer.Character
    if isDownedOrGK(char, l_LocalPlayer) then return end
    
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or l_LocalPlayer:GetAttribute("HasBall") then return end
    local mySide = getMySide()
    if not mySide then return end


    local now = tick()
    local nativeOnCooldown = false
    if ActionController then pcall(function() nativeOnCooldown = ActionController:IsOnCooldown("Tackle") end) end
    if nativeOnCooldown or (now - tackle_lastTackleTime) < 1.0 then return end


    local targetHrp = nil
    for _, player in pairs(s_Players:GetPlayers()) do
        if player ~= l_LocalPlayer and player.Character then
            targetHrp = evaluateTackleTarget(player.Character, player, mySide, hrp)
            if targetHrp then break end
        end
    end


    if not targetHrp then
        local agentFolder = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("Agents")
        if agentFolder then
            for _, npc in pairs(agentFolder:GetChildren()) do
                targetHrp = evaluateTackleTarget(npc, npc, mySide, hrp)
                if targetHrp then break end
            end
        end
    end


    if targetHrp then triggerTackle(targetHrp) end
end


