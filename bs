-- // MAX POWER //
local FootballDefaults = nil
local originalChargeTimes = {}
local originalMaxPower = {}
pcall(function()
    FootballDefaults = require(s_ReplicatedStorage.Shared.Defaults.Football)
    if FootballDefaults then
        if FootballDefaults.ChargeTimes then
            for k, v in pairs(FootballDefaults.ChargeTimes) do originalChargeTimes[k] = v end
        end
        if FootballDefaults.Power then
            for k, v in pairs(FootballDefaults.Power) do originalMaxPower[k] = v end
        end
    end
end)


local maxPowerActive = false
local _lastPayloadWasActive = false  -- tracks payload transitions to detect goal/round end

local function toggleMaxPower(state)
    if not FootballDefaults then return end
    if state == maxPowerActive then return end
    maxPowerActive = state
    if state then
        if FootballDefaults.ChargeTimes then
            for k in pairs(FootballDefaults.ChargeTimes) do FootballDefaults.ChargeTimes[k] = 0.001 end
        end
        if FootballDefaults.Power then
            for k in pairs(FootballDefaults.Power) do
                if type(FootballDefaults.Power[k]) == "number" then
                    FootballDefaults.Power[k] = originalMaxPower[k] * 1.5
                end
            end
        end
    else
        -- Always restore both tables fully so the next charging cycle
        -- starts from clean defaults regardless of what happened mid-round.
        if FootballDefaults.ChargeTimes then
            for k, v in pairs(originalChargeTimes) do FootballDefaults.ChargeTimes[k] = v end
        end
        if FootballDefaults.Power then
            for k, v in pairs(originalMaxPower) do FootballDefaults.Power[k] = v end
        end
    end
end

-- FIX: Called each Heartbeat to detect when a shot payload ends (goal scored,
-- ball released, round reset). When the payload transitions active->inactive we
-- force maxPowerActive back to false so toggleMaxPower(false) doesn't
-- short-circuit on the next shot, ensuring defaults are always restored.
local function onPayloadTransition(payloadIsNowActive)
    if _lastPayloadWasActive and not payloadIsNowActive then
        -- Payload just ended — force a restore regardless of current state
        maxPowerActive = true  -- defeat the early-return guard
        toggleMaxPower(false)
    end
    _lastPayloadWasActive = payloadIsNowActive
end


